#!/usr/bin/env bash
#
# Build the verified libffi source as a static library.
set -euo pipefail

triplet="${1:?Missing target triple}"
dest="${2:-/usr/local/${triplet}}"
build_dir="$(mktemp -d /tmp/libffi.XXXXXX)"
trap 'rm -rf -- "${build_dir}"' EXIT
curl --fail --location --retry 3 --output "${build_dir}/libffi.tar.gz" \
  'https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz'
printf '%s  %s\n' '7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4' "${build_dir}/libffi.tar.gz" | sha256sum --check
tar -xzf "${build_dir}/libffi.tar.gz" --strip-components=1 -C "${build_dir}"
pushd "${build_dir}" >/dev/null
./configure --prefix="${dest}" --libdir="${dest}/lib" \
  --disable-docs --disable-multi-os-directory --disable-shared --enable-static --with-pic
make -j2
make install
popd >/dev/null
test -f "${dest}/include/ffi.h"
test -f "${dest}/lib/libffi.a"
