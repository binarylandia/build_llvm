#!/usr/bin/env bash
#
# Usage: $0 [--dry-run] [--notes <file>] <build time>
#
# Publish the LLVM build in .out/llvm-<version>-<build time>/ as a GitHub
# release of binarylandia/build_llvm. Run it on the host that built it, with gh
# signed in.
#
# The release:
#   - is named llvm-<version>-<build time>, the name of the output folder, for
#     example llvm-22.1.8-2026-10-18_09-00-00
#   - points at the commit that built LLVM, which must be clean and pushed to
#     origin
#   - carries the LLVM archives, the llvm-mingw archives with the MinGW
#     runtimes, SHA256SUMS, and manifest.json with the metadata of the build
#     (LLVM version, source tarball and checksum, projects, runtimes, targets,
#     Darwin tools, MinGW triples, mingw-w64 version and CRT, llvm-mingw commit,
#     base image digest, build commit)
#
# A published release is never changed: the script stops when the release
# exists. A fixed build goes into a new release.
#
# Options:
#   --dry-run       Check and write SHA256SUMS, manifest.json, and the notes,
#                   but publish nothing
#   --notes <file>  Markdown placed above the generated release notes
#   -h, --help      Show this help
#
# Examples:
#   $0 --dry-run 2026-10-18_09-00-00
#   $0 --notes tmp/notes.md 2026-10-18_09-00-00
#
set -euo pipefail
trap "exit" INT
shopt -s nullglob

THIS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
ROOT_DIR="$(realpath "${THIS_DIR}/..")"
REPO="binarylandia/build_llvm"

function fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# Print the output folder of the build time; fail unless exactly one exists.
function find_out_dir() {
  local build_time="${1}"
  local dirs=()
  local dir
  for dir in "${ROOT_DIR}/.out/llvm-"*"-${build_time}"; do
    [[ -d "${dir}" ]] && dirs+=("${dir}")
  done
  ((${#dirs[@]} == 1)) || fail "expected one folder .out/llvm-<version>-${build_time}, found ${#dirs[@]}"
  printf '%s\n' "${dirs[0]}"
}

# Fail unless HEAD is a clean commit that origin has.
function check_commit() {
  local commit="${1}"
  if [[ -n "$(git -C "${ROOT_DIR}" status --porcelain --untracked-files=no)" ]]; then
    fail "the working tree has uncommitted changes"
  fi
  git -C "${ROOT_DIR}" fetch --quiet origin
  if [[ -z "$(git -C "${ROOT_DIR}" branch --remotes --contains "${commit}")" ]]; then
    fail "commit ${commit} is not pushed to origin"
  fi
}

# Fail unless every metadata file comes from a clean build of the commit and
# names files that exist.
function check_metadata() {
  local out_dir="${1}"
  local commit="${2}"
  local meta
  for meta in "${out_dir}"/*.json; do
    [[ "${meta##*/}" == "manifest.json" ]] && continue
    if [[ "$(jq -r '.build_commit' "${meta}")" != "${commit}" ]]; then
      fail "${meta} comes from commit $(jq -r '.build_commit' "${meta}"), not from HEAD ${commit}"
    fi
    if [[ "$(jq -r '.build_dirty' "${meta}")" != "false" ]]; then
      fail "${meta} comes from a build with uncommitted changes"
    fi
    local files=()
    mapfile -t files < <(jq -r '.files[]' "${meta}")
    local file
    for file in "${files[@]}"; do
      [[ -f "${out_dir}/${file}" ]] || fail "${meta} names ${file}, which is missing"
    done
  done
}

function write_notes() {
  local manifest="${1}"
  local notes_file="${2}"
  local notes="${3}"
  {
    if [[ -n "${notes_file}" ]]; then
      cat "${notes_file}"
      printf '\n'
    fi
    jq -r '
      def code: map("`" + . + "`") | join(", ");
      (.toolchains[] |
        "LLVM \(.llvm) for x86_64 Linux, built from `\(.source.name)` (sha256 `\(.source.sha256)`) at commit \(.build_commit[0:12]) of this repository, on `\(.base_image)`.\n",
        "- Projects: \(.projects | code)",
        "- Runtimes: \(.runtimes | code)",
        "- Targets: \(.targets | code)",
        "- Darwin tools for osxcross: \(.darwin_tools | code)",
        "- MinGW triples: \(.mingw.triples | code), in `\(.mingw.files[0] | rtrimstr(".tar.xz")).tar.*`, which unpacks into the prefix of the LLVM archive",
        "- MinGW sources: mingw-w64 \(.mingw.mingw_w64.version) (`\(.mingw.mingw_w64.source.name)`, sha256 `\(.mingw.mingw_w64.source.sha256)`) with the \(.mingw.crt | ascii_upcase) C runtime, built with the scripts of llvm-mingw \(.mingw.llvm_mingw.tag) (commit \(.mingw.llvm_mingw.commit))",
        "- MinGW runtimes, all static, so that programs import only Windows system DLLs: \(.mingw.runtimes | code)"),
      "\n`SHA256SUMS` lists the checksums of the archives, and `manifest.json` the metadata of the build."
    ' "${manifest}"
  } >"${notes}"
}

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  local dry_run=false
  local notes_file=""

  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      show_help
      exit 0
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --notes)
      notes_file="$(realpath "${2:?--notes needs a file}")"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf "Unknown option: %s\n" "${1}" >&2
      exit 1
      ;;
    *) break ;;
    esac
  done

  local build_time="${1:-}"
  [[ -n "${build_time}" ]] || {
    show_help >&2
    exit 1
  }
  local out_dir
  out_dir="$(find_out_dir "${build_time}")"
  local tag="${out_dir##*/}"

  local commit
  commit="$(git -C "${ROOT_DIR}" rev-parse HEAD)"
  check_commit "${commit}"
  check_metadata "${out_dir}" "${commit}"

  local metadata=()
  local meta
  for meta in "${out_dir}"/*.json; do
    [[ "${meta##*/}" == "manifest.json" ]] || metadata+=("${meta}")
  done
  ((${#metadata[@]} == 1)) || fail "${out_dir} has ${#metadata[@]} metadata files, expected one"
  if [[ "$(jq -r '.name' "${metadata[0]}")" != "${tag}" ]]; then
    fail "${metadata[0]} describes $(jq -r '.name' "${metadata[0]}"), not ${tag}"
  fi

  if gh release view "${tag}" --repo="${REPO}" >/dev/null 2>&1; then
    fail "release ${tag} exists; a published release is never changed"
  fi

  local manifest="${out_dir}/manifest.json"
  jq -s --arg repository "${REPO}" --arg commit "${commit}" --arg build_time "${build_time}" \
    '{repository: $repository, commit: $commit, build_time: $build_time, toolchains: .}' \
    "${metadata[@]}" >"${manifest}"

  local files=()
  mapfile -t files < <(jq -r '.toolchains[].files[]' "${manifest}" | LC_ALL=C sort)
  pushd "${out_dir}" >/dev/null
  sha256sum -- "${files[@]}" >SHA256SUMS
  popd >/dev/null

  local notes="${out_dir}/release-notes.md"
  write_notes "${manifest}" "${notes_file}" "${notes}"

  printf 'Release %s at %s\n' "${tag}" "${commit}"
  cat "${notes}"
  if "${dry_run}"; then
    printf '\nDry run: nothing published\n'
    return
  fi

  pushd "${out_dir}" >/dev/null
  gh release create "${tag}" \
    --repo="${REPO}" \
    --target="${commit}" \
    --title="${tag}" \
    --notes-file="${notes}" \
    -- "${files[@]}" SHA256SUMS manifest.json
  popd >/dev/null
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
