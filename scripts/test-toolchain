#!/usr/bin/env bash
#
# Usage: scripts/test-toolchain INSTALL_DIR LLVM_VERSION
# Check installed compilers, native runtimes, WebAssembly linking, the Darwin
# tools of the osxcross llvm flavor, and the MinGW runtimes (scripts/test-mingw).
set -euo pipefail
trap "exit" INT

THIS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

# shellcheck source=scripts/llvm-tools.sh
source "${THIS_DIR}/llvm-tools.sh"

# Fail when a Darwin tool is missing from the installation or does not report
# the LLVM version.
check_darwin_tools() {
  local install_dir="${1}"
  local version="${2}"
  local tool output
  for tool in "${DARWIN_TOOLS[@]}"; do
    if [[ ! -x "${install_dir}/bin/${tool}" ]]; then
      printf 'Missing Darwin tool: %s\n' "${install_dir}/bin/${tool}" >&2
      return 1
    fi
    if ! output="$("${install_dir}/bin/${tool}" --version 2>&1)"; then
      printf '%s --version failed:\n%s\n' "${tool}" "${output}" >&2
      return 1
    fi
    if [[ "${output}" != *"${version}"* ]]; then
      printf '%s --version does not report LLVM %s:\n%s\n' "${tool}" "${version}" "${output}" >&2
      return 1
    fi
  done
  printf 'Darwin tools: %s\n' "${DARWIN_TOOLS[*]}"
}

# Fail when an LLVM tool that the MinGW tools link to is missing.
check_mingw_tools() {
  local install_dir="${1}"
  local tool
  for tool in "${MINGW_TOOLS[@]}"; do
    if [[ ! -x "${install_dir}/bin/${tool}" ]]; then
      printf 'Missing MinGW tool: %s\n' "${install_dir}/bin/${tool}" >&2
      return 1
    fi
  done
  printf 'MinGW tools: %s\n' "${MINGW_TOOLS[*]}"
}

main() {
  local install_dir="${1:?Missing installation directory}"
  local version="${2:?Missing LLVM version}"
  local test_dir
  test_dir="$(mktemp -d "${PWD}/.build/llvm-smoke.XXXXXX")"
  trap 'rm -rf -- "${test_dir}"' EXIT
  export PATH="${install_dir}/bin:${PATH}"
  clang --version | tee "${test_dir}/version.txt"
  grep -F -- "clang version ${version}" "${test_dir}/version.txt"
  clang --print-targets
  ld.lld --version
  lldb --version
  flang --version
  check_darwin_tools "${install_dir}" "${version}"
  check_mingw_tools "${install_dir}"

  local tool
  for tool in "${install_dir}/bin/"* "${install_dir}/lib/"*.so*; do
    [[ -f "${tool}" ]] || continue
    [[ "$(od -An -tx1 -N4 "${tool}")" == ' 7f 45 4c 46' ]] || continue
    readelf --dynamic "${tool}" >"${test_dir}/dynamic.txt"
    if grep -E '\(NEEDED\).*\[(libz\.so|libzstd\.so|libquadmath\.so|libgcc_s\.so|libstdc\+\+\.so)' "${test_dir}/dynamic.txt"; then
      printf 'Unexpected shared runtime dependency in %s\n' "${tool}" >&2
      return 1
    fi
    readelf --version-info "${tool}" >"${test_dir}/versions.txt"
    awk -v tool="${tool}" '
      /Name: GLIBC_/ {
        for (i = 1; i < NF; i++) {
          if ($i == "Name:") {
            name = $(i + 1)
            sub(/^GLIBC_/, "", name)
            split(name, version, ".")
            if (version[1] > 2 || (version[1] == 2 && version[2] > 17)) {
              print tool ": requires glibc " name " beyond baseline 2.17" > "/dev/stderr"
              failed = 1
            }
          }
        }
      }
      END { exit failed }
    ' "${test_dir}/versions.txt"
  done

  cat >"${test_dir}/main.c" <<'EOF'
int main(void) { return 0; }
EOF
  clang -static "${test_dir}/main.c" -o "${test_dir}/native-c"
  "${test_dir}/native-c"

  cat >"${test_dir}/main.cpp" <<'EOF'
#include <stdexcept>
#include <vector>
int main() {
  try { throw std::runtime_error("expected"); }
  catch (const std::exception&) { return std::vector<int>{42}.at(0) != 42; }
}
EOF
  clang++ -static "${test_dir}/main.cpp" -o "${test_dir}/native-cxx"
  "${test_dir}/native-cxx"
  clang++ -fuse-ld=lld -stdlib=libc++ --rtlib=compiler-rt --unwindlib=libunwind -static -pthread \
    "${test_dir}/main.cpp" -ldl -o "${test_dir}/native-libcxx"
  "${test_dir}/native-libcxx"

  cat >"${test_dir}/main.f90" <<'EOF'
program smoke
  implicit none
  real :: values(2) = [1.0, 2.0]
  if (sum(values) /= 3.0) stop 1
end program
EOF
  flang "${test_dir}/main.f90" -o "${test_dir}/native-fortran"
  "${test_dir}/native-fortran"

  cat >"${test_dir}/openmp.c" <<'EOF'
#include <omp.h>
int main(void) {
  int count = 0;
  #pragma omp parallel reduction(+:count) num_threads(2)
  count += 1;
  return count != 2;
}
EOF
  clang -fuse-ld=lld -fopenmp -static-libgcc -pthread "${test_dir}/openmp.c" -ldl -o "${test_dir}/native-openmp"
  "${test_dir}/native-openmp"

  cat >"${test_dir}/wasm.c" <<'EOF'
int add(int a, int b) { return a + b; }
EOF
  local target
  for target in wasm32 wasm64; do
    clang --target="${target}-unknown-unknown" -O2 -c "${test_dir}/wasm.c" -o "${test_dir}/${target}.o"
    llvm-ar rcs "${test_dir}/${target}.a" "${test_dir}/${target}.o"
    wasm-ld -m "${target}" --no-entry --export=add "${test_dir}/${target}.a" -o "${test_dir}/${target}.wasm"
    local magic
    magic="$(od -An -tx1 -N8 "${test_dir}/${target}.wasm")"
    [[ "${magic}" == ' 00 61 73 6d 01 00 00 00' ]]
  done
  printf 'Native compiler/runtime and wasm32/wasm64 smoke checks passed\n'
  "${THIS_DIR}/test-mingw" "${install_dir}"
  rm -rf -- "${test_dir}"
  trap - EXIT
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
