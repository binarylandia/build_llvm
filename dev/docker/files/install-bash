#!/usr/bin/env bash
#
# Bootstrap Bash 5.3.20 from verified GNU release sources.
set -euo pipefail

build_dir="$(mktemp -d /tmp/bash.XXXXXX)"
trap 'rm -rf -- "${build_dir}"' EXIT
pushd "${build_dir}" >/dev/null
while read -r checksum filename; do
  if [[ "${filename}" == bash-5.3.tar.gz ]]; then
    url="https://ftp.gnu.org/gnu/bash/${filename}"
  else
    url="https://ftp.gnu.org/gnu/bash/bash-5.3-patches/${filename}"
  fi
  curl --fail --location --retry 3 --output "${filename}" "${url}"
done </install-bash.sha256
sha256sum --check /install-bash.sha256
mkdir source
tar -xzf bash-5.3.tar.gz --strip-components=1 -C source
for patch_file in bash53-???; do
  patch --batch --fuzz=0 -p0 -d source <"${patch_file}"
done
pushd source >/dev/null
./configure --prefix=/usr/local --without-bash-malloc --disable-nls
make -j2
make install
popd >/dev/null
popd >/dev/null
/usr/local/bin/bash --version
