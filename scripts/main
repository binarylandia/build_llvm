#!/usr/bin/env bash
#
# Usage: scripts/main [LLVM_VERSION]
# Build LLVM and the MinGW runtimes on top of it, verify them, and package them
# inside the builder container: the LLVM archives hold the LLVM installation,
# and the llvm-mingw archives hold the MinGW runtimes, which unpack into the
# same prefix (scripts/build-mingw). LLVM builds in three stages: GCC builds a
# first clang, an instrumented clang records a profile on a training build, and
# the first clang builds the installation with that profile and ThinLTO. Every
# stage compiles and links on the glibc 2.17 sysroot of the host GCC toolchain.
# JOBS controls compile parallelism; LINK_JOBS controls link parallelism.
# ./build sets BUILD_TIME, SOURCE_DATE_EPOCH, and the provenance that the
# metadata records (DOCKER_BASE_IMAGE, BUILD_COMMIT, BUILD_DIRTY).
set -euo pipefail
trap "exit" INT

THIS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
ROOT_DIR="$(dirname "${THIS_DIR}")"

# shellcheck source=scripts/llvm-tools.sh
source "${THIS_DIR}/llvm-tools.sh"
# shellcheck source=scripts/mingw.sh
source "${THIS_DIR}/mingw.sh"

PROJECTS=(clang clang-tools-extra flang lld lldb)
RUNTIMES=(libcxx libcxxabi libunwind compiler-rt openmp flang-rt)
TARGETS=(X86 AArch64 ARM WebAssembly)

# Print the arguments separated by semicolons, as CMake lists are.
function cmake_list() {
  local IFS=";"
  printf '%s' "$*"
}

# Print the checksum of a source archive from scripts/sources.sha256.
function source_checksum() {
  local name="${1}"
  local checksum
  checksum="$(awk -v name="${name}" '$2 == name {print $1}' "${THIS_DIR}/sources.sha256")"
  if [[ ! "${checksum}" =~ ^[a-f0-9]{64}$ ]]; then
    printf 'No verified source checksum for %s\n' "${name}" >&2
    return 1
  fi
  printf '%s\n' "${checksum}"
}

# Download a source archive into tarballs/ unless it is there, and fail unless
# it matches its checksum in scripts/sources.sha256.
function fetch_source() {
  local name="${1}"
  local url="${2}"
  local archive="${ROOT_DIR}/tarballs/${name}"
  local checksum
  checksum="$(source_checksum "${name}")"
  mkdir -p "${ROOT_DIR}/tarballs"
  if [[ ! -f "${archive}" ]]; then
    curl --fail --location --retry 3 --output "${archive}.part" "${url}"
    mv -- "${archive}.part" "${archive}"
  fi
  printf '%s  %s\n' "${checksum}" "${archive}" | sha256sum --check
}

# Print one line per entry of a directory: the path, type, mode, and link
# target, and for a regular file also its sha256. The lines are sorted, so the
# manifests of two states of a directory compare with comm.
function tree_manifest() {
  local dir="${1}"
  pushd "${dir}" >/dev/null
  {
    find . -mindepth 1 -printf 'entry\t%P\t%y\t%m\t%l\n'
    find . -type f -exec sha256sum -- {} + | sed 's/^/sha256\t/'
  } | LC_ALL=C sort
  popd >/dev/null
}

# Print the sorted paths of a manifest.
function manifest_paths() {
  local manifest="${1}"
  awk -F '\t' '$1 == "entry" {print $2}' "${manifest}" | LC_ALL=C sort
}

# Write the listed entries of a directory as a tar stream to stdout. The entries
# are sorted, owned by root, and carry the time SOURCE_DATE_EPOCH, so the same
# files always give the same archive. Each path is listed once; tar does not
# recurse.
function tar_paths() {
  local input_dir="${1}"
  local paths_file="${2}"
  tar --posix --no-recursion --mtime="@${SOURCE_DATE_EPOCH}" --owner=0 --group=0 --numeric-owner \
    --pax-option=exthdr.name=%d/PaxHeaders/%f,delete=atime,delete=ctime \
    -cf - -C "${input_dir}" --files-from="${paths_file}"
}

# The compressors give the same output for the same input with any number of
# threads: xz in its multi-threaded mode, pigz without the file name and time,
# and zstd always. pigz 2.3 stores the time unless -T is given.
function package_xz() {
  local input_dir="${1}"
  local paths_file="${2}"
  local output_basename="${3}"
  tar_paths "${input_dir}" "${paths_file}" | xz -T "$(($(nproc) > 1 ? $(nproc) : 2))" -5 >"${output_basename}.tar.xz"
}

function package_gz() {
  local input_dir="${1}"
  local paths_file="${2}"
  local output_basename="${3}"
  tar_paths "${input_dir}" "${paths_file}" | pigz -n -T -p "$(nproc)" -7 >"${output_basename}.tar.gz"
}

function package_zst() {
  local input_dir="${1}"
  local paths_file="${2}"
  local output_basename="${3}"
  tar_paths "${input_dir}" "${paths_file}" | zstd -q -T"$(nproc)" -7 >"${output_basename}.tar.zst"
}

function package_all() {
  local input_dir="${1}"
  local paths_file="${2}"
  local output_basename="${3}"
  package_xz "${input_dir}" "${paths_file}" "${output_basename}"
  package_gz "${input_dir}" "${paths_file}" "${output_basename}"
  package_zst "${input_dir}" "${paths_file}" "${output_basename}"
}

# Print the archive names of a basename as a JSON array.
function archive_names() {
  local basename="${1}"
  jq -nc --arg name "${basename}" '[($name + ".tar.xz"), ($name + ".tar.gz"), ($name + ".tar.zst")]'
}

# Write <archive basename>.json with the facts of the build that scripts/release
# puts into the manifest of a release. files lists the archives of the build:
# the LLVM archives and the llvm-mingw archives.
function write_metadata() {
  local output_basename="${1}"
  local mingw_basename="${2}"
  local version="${3}"
  local source_name="${4}"
  local source_sha256="${5}"
  local install_dir="${6}"
  local build_time="${7}"
  local name="${output_basename##*/}"
  local installed=()
  local tool
  for tool in "${DARWIN_TOOLS[@]}"; do
    if [[ -e "${install_dir}/bin/${tool}" ]]; then
      installed+=("${tool}")
    fi
  done
  jq -n \
    --arg name "${name}" \
    --arg llvm "${version}" \
    --arg source_name "${source_name}" \
    --arg source_sha256 "${source_sha256}" \
    --arg projects "$(cmake_list "${PROJECTS[@]}")" \
    --arg runtimes "$(cmake_list "${RUNTIMES[@]}")" \
    --arg targets "$(cmake_list "${TARGETS[@]}")" \
    --arg darwin_tools "$(cmake_list "${installed[@]}")" \
    --arg base_image "${DOCKER_BASE_IMAGE:?}" \
    --slurpfile host_gcc "${HOST_GCC_RECORD:?}" \
    --arg build_commit "${BUILD_COMMIT:?}" \
    --argjson build_dirty "${BUILD_DIRTY:?}" \
    --arg build_time "${build_time}" \
    --argjson llvm_files "$(archive_names "${name}")" \
    --argjson mingw_files "$(archive_names "${mingw_basename}")" \
    --arg mingw_triples "$(mingw_triples | paste -sd ';' -)" \
    --arg mingw_runtimes "$(cmake_list "${MINGW_RUNTIMES[@]}")" \
    --arg mingw_crt "${MINGW_CRT}" \
    --arg mingw_win32_winnt "${MINGW_WIN32_WINNT}" \
    --arg mingw_w64_version "${MINGW_W64_VERSION}" \
    --arg mingw_w64_source "${MINGW_W64_SOURCE}" \
    --arg mingw_w64_sha256 "$(source_checksum "${MINGW_W64_SOURCE}")" \
    --arg llvm_mingw_tag "${LLVM_MINGW_TAG}" \
    --arg llvm_mingw_commit "${LLVM_MINGW_COMMIT}" \
    --arg llvm_mingw_source "${LLVM_MINGW_SOURCE}" \
    --arg llvm_mingw_sha256 "$(source_checksum "${LLVM_MINGW_SOURCE}")" \
    '{name: $name, llvm: $llvm, source: {name: $source_name, sha256: $source_sha256},
      projects: ($projects | split(";")), runtimes: ($runtimes | split(";")), targets: ($targets | split(";")),
      darwin_tools: ($darwin_tools | split(";")),
      mingw: {files: $mingw_files, triples: ($mingw_triples | split(";")),
        runtimes: ($mingw_runtimes | split(";")), linkage: "static", crt: $mingw_crt,
        win32_winnt: $mingw_win32_winnt,
        mingw_w64: {version: $mingw_w64_version, source: {name: $mingw_w64_source, sha256: $mingw_w64_sha256}},
        llvm_mingw: {repository: "https://github.com/mstorsjo/llvm-mingw", tag: $llvm_mingw_tag,
          commit: $llvm_mingw_commit, source: {name: $llvm_mingw_source, sha256: $llvm_mingw_sha256}}},
      build: {stages: ["stage 1: GCC 16 builds clang and the LLVM runtimes",
          "stage 2: an IR-instrumented clang and lld run a training build",
          "stage 3: the clang of stage 1 builds the installation with the profile and ThinLTO"],
        cxx_runtime: "libc++, libc++abi, and libunwind of stage 1, linked statically", host_glibc: "2.17",
        host_gcc: $host_gcc[0]},
      base_image: $base_image, build_commit: $build_commit, build_dirty: $build_dirty, build_time: $build_time,
      files: ($llvm_files + $mingw_files)}' \
    >"${output_basename}.json"
}

# Write the clang configuration of the glibc 2.17 target into a bin folder.
# clang reads <triple>.cfg next to itself whenever it compiles for the triple,
# so every clang of the stages, and the runtimes that the clang of a build tree
# compiles, use the sysroot, crt files, and libgcc of the host GCC toolchain and
# link with lld. The installation gets no configuration: its clang uses the
# headers and libraries of the system it runs on.
function write_target_config() {
  local bin_dir="${1}"
  local gcc_install_dir
  gcc_install_dir="$(find "${HOST_GCC_DIR}/lib/gcc/${HOST_TUPLE}" -mindepth 1 -maxdepth 1 -type d)"
  mkdir -p "${bin_dir}"
  printf -- '%s\n' \
    "--sysroot=${HOST_GCC_DIR}/${HOST_TUPLE}/sysroot" \
    "--gcc-install-dir=${gcc_install_dir}" \
    "-fuse-ld=lld" \
    >"${bin_dir}/${HOST_TUPLE}.cfg"
}

# Print the CMake options that every stage shares. Every lld links zlib and
# zstd: the crt files of the glibc 2.17 sysroot have compressed debug sections.
function common_cmake_options() {
  printf '%s\n' \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_PREFIX_PATH="${HOST_LIBS_DIR}" \
    -DLLVM_ENABLE_ZLIB=FORCE_ON \
    -DZLIB_INCLUDE_DIR="${HOST_LIBS_DIR}/include" \
    -DZLIB_LIBRARY_RELEASE="${HOST_LIBS_DIR}/lib/libz.a" \
    -DZLIB_USE_STATIC_LIBS=ON \
    -DLLVM_ENABLE_ZSTD=FORCE_ON \
    -DLLVM_USE_STATIC_ZSTD=ON \
    -DLLVM_DEFAULT_TARGET_TRIPLE="${HOST_TUPLE}" \
    -DLLVM_ENABLE_BINDINGS=OFF \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_INCLUDE_TESTS=OFF
}

# Print the CMake options of a stage that the clang of stage 1 compiles: the
# tools link libc++, libc++abi, libunwind, and the compiler-rt builtins of stage
# 1 statically, so they need neither libstdc++ nor libgcc_s at run time.
function stage1_compiler_options() {
  local stage1_dir="${1}"
  local link_flags="-rtlib=compiler-rt --unwindlib=libunwind -static-libgcc"
  printf '%s\n' \
    -DCMAKE_C_COMPILER="${stage1_dir}/bin/clang" \
    -DCMAKE_CXX_COMPILER="${stage1_dir}/bin/clang++" \
    -DCMAKE_AR="${stage1_dir}/bin/llvm-ar" \
    -DCMAKE_RANLIB="${stage1_dir}/bin/llvm-ranlib" \
    -DLLVM_ENABLE_LLD=ON \
    -DLLVM_ENABLE_LIBCXX=ON \
    -DLLVM_STATIC_LINK_CXX_STDLIB=ON \
    -DCMAKE_EXE_LINKER_FLAGS="${link_flags}" \
    -DCMAKE_SHARED_LINKER_FLAGS="${link_flags}" \
    -DCMAKE_MODULE_LINKER_FLAGS="${link_flags}"
}

# Stage 1: the GCC of the host toolchain builds clang, lld, and the runtimes
# that the later stages link (static libc++, libc++abi, libunwind) and need for
# profiling (compiler-rt builtins and profile runtime).
function build_stage1() {
  local source_dir="${1}"
  local build_dir="${2}"
  local stage1_dir="${3}"
  local jobs="${4}"
  local link_jobs="${5}"
  write_target_config "${build_dir}/bin"
  local options=()
  mapfile -t options < <(common_cmake_options)
  cmake -S "${source_dir}/llvm" -B "${build_dir}" "${options[@]}" \
    -DCMAKE_INSTALL_PREFIX="${stage1_dir}" \
    -DCMAKE_C_COMPILER="${HOST_GCC_DIR}/bin/${HOST_TUPLE}-gcc" \
    -DCMAKE_CXX_COMPILER="${HOST_GCC_DIR}/bin/${HOST_TUPLE}-g++" \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DLLVM_PARALLEL_LINK_JOBS="${link_jobs}" \
    -DLLVM_TARGETS_TO_BUILD=X86 \
    -DLLVM_ENABLE_PROJECTS="clang;lld" \
    -DLLVM_ENABLE_RUNTIMES="compiler-rt;libcxx;libcxxabi;libunwind" \
    -DLLVM_STATIC_LINK_CXX_STDLIB=ON \
    -DCOMPILER_RT_BUILD_SANITIZERS=OFF \
    -DCOMPILER_RT_BUILD_XRAY=OFF \
    -DCOMPILER_RT_BUILD_LIBFUZZER=OFF \
    -DCOMPILER_RT_BUILD_MEMPROF=OFF \
    -DCOMPILER_RT_BUILD_ORC=OFF \
    -DCOMPILER_RT_BUILD_CTX_PROFILE=OFF \
    -DLIBCXX_ENABLE_SHARED=OFF \
    -DLIBCXXABI_ENABLE_SHARED=OFF \
    -DLIBUNWIND_ENABLE_SHARED=OFF \
    -DLIBCXXABI_USE_LLVM_UNWINDER=ON \
    -DLIBCXX_STATICALLY_LINK_ABI_IN_STATIC_LIBRARY=ON \
    -DLIBCXXABI_STATICALLY_LINK_UNWINDER_IN_STATIC_LIBRARY=ON
  cmake --build "${build_dir}" --parallel "${jobs}"
  rm -rf -- "${stage1_dir}"
  cmake --install "${build_dir}"
  write_target_config "${stage1_dir}/bin"
}

# Stage 2: the clang of stage 1 builds a clang and an lld that record an IR
# profile of what they run (LLVM_BUILD_INSTRUMENTED) into the profiles/ folder
# of the build.
function build_instrumented() {
  local source_dir="${1}"
  local build_dir="${2}"
  local stage1_dir="${3}"
  local jobs="${4}"
  local link_jobs="${5}"
  write_target_config "${build_dir}/bin"
  local options=() compiler=()
  mapfile -t options < <(common_cmake_options)
  mapfile -t compiler < <(stage1_compiler_options "${stage1_dir}")
  cmake -S "${source_dir}/llvm" -B "${build_dir}" "${options[@]}" "${compiler[@]}" \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DLLVM_PARALLEL_LINK_JOBS="${link_jobs}" \
    -DLLVM_TARGETS_TO_BUILD=X86 \
    -DLLVM_ENABLE_PROJECTS="clang;lld" \
    -DLLVM_BUILD_INSTRUMENTED=IR
  cmake --build "${build_dir}" --parallel "${jobs}" --target clang lld
}

# Run the instrumented clang and lld on a training build, and merge their
# profiles. The training build compiles and links a part of LLVM and Clang
# with optimization, which exercises the parser, the C++ semantics, the
# optimizer, the x86 code generator, and the linker.
function train() {
  local source_dir="${1}"
  local instrumented_build="${2}"
  local stage1_dir="${3}"
  local profdata="${4}"
  local jobs="${5}"
  local training_build="${source_dir}/training"
  rm -rf -- "${training_build}" "${instrumented_build}/profiles"
  local options=()
  mapfile -t options < <(common_cmake_options)
  cmake -S "${source_dir}/llvm" -B "${training_build}" "${options[@]}" \
    -DCMAKE_C_COMPILER="${instrumented_build}/bin/clang" \
    -DCMAKE_CXX_COMPILER="${instrumented_build}/bin/clang++" \
    -DLLVM_ENABLE_LLD=ON \
    -DLLVM_TARGETS_TO_BUILD=X86 \
    -DLLVM_ENABLE_PROJECTS=clang
  cmake --build "${training_build}" --parallel "${jobs}" --target opt clangSema clangCodeGen
  local profiles=()
  mapfile -t profiles < <(find "${instrumented_build}/profiles" -name '*.profraw')
  if ((${#profiles[@]} == 0)); then
    printf 'The training build wrote no profiles into %s\n' "${instrumented_build}/profiles" >&2
    return 1
  fi
  "${stage1_dir}/bin/llvm-profdata" merge --output="${profdata}" "${profiles[@]}"
  rm -rf -- "${training_build}"
}

# Stage 3: the clang of stage 1 builds the installation with the profile and
# ThinLTO. The runtimes of the installation are compiled by the clang of this
# build for glibc 2.17.
function build_final() {
  local source_dir="${1}"
  local build_dir="${2}"
  local stage1_dir="${3}"
  local profdata="${4}"
  local install_dir="${5}"
  local version="${6}"
  local jobs="${7}"
  local link_jobs="${8}"
  local tools projects runtimes targets
  tools="$(toolchain_tools)"
  projects="$(cmake_list "${PROJECTS[@]}")"
  runtimes="$(cmake_list "${RUNTIMES[@]}")"
  targets="$(cmake_list "${TARGETS[@]}")"
  write_target_config "${build_dir}/bin"
  local options=() compiler=()
  mapfile -t options < <(common_cmake_options)
  mapfile -t compiler < <(stage1_compiler_options "${stage1_dir}")
  cmake -S "${source_dir}/llvm" -B "${build_dir}" "${options[@]}" "${compiler[@]}" \
    -DCMAKE_INSTALL_PREFIX="${install_dir}" \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DCMAKE_C_FLAGS="-g0" \
    -DCMAKE_CXX_FLAGS="-g0" \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DLLVM_PARALLEL_LINK_JOBS="${link_jobs}" \
    -DLLVM_ENABLE_LTO=Thin \
    -DLLVM_PROFDATA_FILE="${profdata}" \
    -DLLVM_ENABLE_PROJECTS="${projects}" \
    -DLLVM_ENABLE_RUNTIMES="${runtimes}" \
    -DLLVM_TARGETS_TO_BUILD="${targets}" \
    -DLLVM_FORCE_VC_REPOSITORY=https://github.com/llvm/llvm-project \
    -DLLVM_FORCE_VC_REVISION="llvmorg-${version}" \
    -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
    -DLLVM_TOOLCHAIN_TOOLS="${tools}" \
    -DLLVM_BUILD_TOOLS=ON \
    -DLLVM_INCLUDE_TOOLS=ON \
    -DLLVM_INSTALL_TOOLS=ON \
    -DLLVM_TOOLS_INSTALL_DIR=bin \
    -DCLANG_BUILD_TOOLS=ON \
    -DCLANG_INCLUDE_TOOLS=ON \
    -DCLANG_INSTALL_TOOLS=ON \
    -DCLANG_OPENMP_RUNTIME=libomp \
    -DCLANG_PLUGIN_SUPPORT=ON \
    -DLLVM_ENABLE_FFI=ON \
    -DFFI_INCLUDE_DIR="${HOST_LIBS_DIR}/include" \
    -DFFI_LIBRARY_DIR="${HOST_LIBS_DIR}/lib" \
    -DLLVM_ENABLE_RTTI=ON \
    -DLLVM_ENABLE_THREADS=ON \
    -DLLVM_ENABLE_LIBXML2=FORCE_ON \
    -DLIBCXX_STATICALLY_LINK_ABI_IN_STATIC_LIBRARY=ON \
    -DLIBCXX_STATICALLY_LINK_ABI_IN_SHARED_LIBRARY=ON \
    -DLIBCXX_ENABLE_ABI_LINKER_SCRIPT=OFF \
    -DLIBCXXABI_STATICALLY_LINK_UNWINDER_IN_STATIC_LIBRARY=ON \
    -DLIBCXXABI_STATICALLY_LINK_UNWINDER_IN_SHARED_LIBRARY=ON \
    -DLIBOMP_ENABLE_SHARED=OFF \
    -DLLVM_USE_PERF=ON \
    -DLLDB_ENABLE_PYTHON=OFF \
    -DLLDB_ENABLE_CURSES=OFF \
    -DLLDB_ENABLE_LIBEDIT=OFF \
    -DLLVM_INCLUDE_UTILS=OFF
  cmake --build "${build_dir}" --parallel "${jobs}"
  rm -rf -- "${install_dir}"
  mkdir -p "${install_dir}"
  cmake --install "${build_dir}"
}

main() {
  local var
  for var in SOURCE_DATE_EPOCH DOCKER_BASE_IMAGE BUILD_COMMIT BUILD_DIRTY HOST_TUPLE HOST_GCC_DIR HOST_GCC_RECORD HOST_LIBS_DIR; do
    if [[ -z "${!var:-}" ]]; then
      printf '%s is not set; run scripts/main through ./build\n' "${var}" >&2
      return 1
    fi
  done
  local version="${1:-${LLVM_VERSION:-23.1.4}}"
  local jobs="${JOBS:-6}"
  local link_jobs="${LINK_JOBS:-1}"
  local source_name="llvm-project-${version}.src.tar.xz"
  local source_dir="${ROOT_DIR}/.build/llvm-${version}"
  local install_dir="/opt/llvm/${version}"
  local build_time
  build_time="${BUILD_TIME:-$(date -u '+%Y-%m-%d_%H-%M-%S')}"
  local output_dir="${ROOT_DIR}/.out/llvm-${version}-${build_time}"
  local mingw_dir="${ROOT_DIR}/.build/llvm-${version}-mingw"
  local archive="${ROOT_DIR}/tarballs/${source_name}"
  local checksum
  checksum="$(source_checksum "${source_name}")"
  mkdir -p "${source_dir}" "${mingw_dir}" "${output_dir}" "${install_dir}"
  fetch_source "${source_name}" \
    "https://github.com/llvm/llvm-project/releases/download/llvmorg-${version}/${source_name}"
  fetch_source "${LLVM_MINGW_SOURCE}" "${LLVM_MINGW_URL}"
  fetch_source "${MINGW_W64_SOURCE}" "${MINGW_W64_URL}"
  if [[ ! -f "${source_dir}/llvm/CMakeLists.txt" ]]; then
    tar -xJf "${archive}" --strip-components=1 -C "${source_dir}"
  fi
  local patch_file
  for patch_file in "${ROOT_DIR}/patches/"[0-9][0-9][0-9]-*.patch; do
    if [[ ! -f "${source_dir}/.${patch_file##*/}.applied" ]]; then
      patch --batch --fuzz=0 --forward -p1 -d "${source_dir}" <"${patch_file}"
      touch "${source_dir}/.${patch_file##*/}.applied"
    fi
  done

  local stage1_build="${source_dir}/stage1"
  local stage1_dir="${source_dir}/stage1-install"
  local instrumented_build="${source_dir}/stage2-instrumented"
  local profdata="${source_dir}/clang.profdata"
  export CCACHE_DIR="/cache/ccache"
  export CCACHE_NOCOMPRESS="1"
  export CCACHE_MAXSIZE="50G"
  unset CFLAGS CXXFLAGS LDFLAGS

  build_stage1 "${source_dir}" "${stage1_build}" "${stage1_dir}" "${jobs}" "${link_jobs}" 2>&1 |
    tee "${source_dir}/stage1.log"
  build_instrumented "${source_dir}" "${instrumented_build}" "${stage1_dir}" "${jobs}" "${link_jobs}" 2>&1 |
    tee "${source_dir}/stage2-instrumented.log"
  train "${source_dir}" "${instrumented_build}" "${stage1_dir}" "${profdata}" "${jobs}" 2>&1 |
    tee "${source_dir}/training.log"
  build_final "${source_dir}" "${source_dir}/build" "${stage1_dir}" "${profdata}" "${install_dir}" "${version}" \
    "${jobs}" "${link_jobs}" 2>&1 | tee "${source_dir}/build.log"

  # The MinGW stage may add files to the installation, but must not change any
  # file of LLVM, so that the LLVM archives hold the same files as without it.
  local llvm_manifest="${mingw_dir}/llvm.manifest"
  local full_manifest="${mingw_dir}/llvm-mingw.manifest"
  tree_manifest "${install_dir}" >"${llvm_manifest}"
  "${THIS_DIR}/build-mingw" "${install_dir}" "${source_dir}" "${mingw_dir}" \
    "${ROOT_DIR}/tarballs/${LLVM_MINGW_SOURCE}" "${ROOT_DIR}/tarballs/${MINGW_W64_SOURCE}" "${jobs}" \
    2>&1 | tee "${mingw_dir}/build.log"
  tree_manifest "${install_dir}" >"${full_manifest}"
  local changed
  changed="$(LC_ALL=C comm -23 "${llvm_manifest}" "${full_manifest}")"
  if [[ -n "${changed}" ]]; then
    printf 'The MinGW stage changed files of the LLVM installation:\n%s\n' "${changed}" >&2
    return 1
  fi
  local llvm_paths="${mingw_dir}/llvm.paths"
  local mingw_paths="${mingw_dir}/mingw.paths"
  manifest_paths "${llvm_manifest}" >"${llvm_paths}"
  manifest_paths "${full_manifest}" | LC_ALL=C comm -13 "${llvm_paths}" - >"${mingw_paths}"

  "${THIS_DIR}/test-toolchain" "${install_dir}" "${version}" 2>&1 | tee "${source_dir}/verify.log"

  local basename="llvm-${version}-${build_time}"
  local mingw_basename="llvm-mingw-${version}-${build_time}"
  package_all "${install_dir}" "${llvm_paths}" "${output_dir}/${basename}"
  package_all "${install_dir}" "${mingw_paths}" "${output_dir}/${mingw_basename}"
  write_metadata "${output_dir}/${basename}" "${mingw_basename}" "${version}" "${source_name}" "${checksum}" \
    "${install_dir}" "${build_time}"
  local names
  names="$(jq -r '.files[]' "${output_dir}/${basename}.json")"
  local files=()
  mapfile -t files <<<"${names}"
  pushd "${output_dir}" >/dev/null
  sha256sum -- "${files[@]}" >SHA256SUMS
  sha256sum --check SHA256SUMS
  popd >/dev/null
  printf 'Verified artifacts: %s\n' "${output_dir}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
