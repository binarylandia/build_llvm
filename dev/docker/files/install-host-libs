#!/usr/bin/env bash
#
# Usage: $0 <gcc-prefix> <prefix>
#
# Build the libraries that the LLVM tools link statically, from verified
# upstream sources, with the GCC toolchain of install-host-gcc, into a prefix:
#   - zlib and zstd: compressed debug sections and LLVM's compression support
#   - libxml2: llvm-mt and the Windows manifests of lld
#   - libffi: the external function calls of the LLVM interpreter
# The libraries are position-independent, so they link into executables and
# shared libraries alike.
#
set -euo pipefail

gcc_prefix="${1:?gcc prefix}"
dest="${2:?prefix}"
tuple="x86_64-unknown-linux-gnu"

export CC="${gcc_prefix}/bin/${tuple}-gcc"
export CXX="${gcc_prefix}/bin/${tuple}-g++"
export AR="${gcc_prefix}/bin/${tuple}-gcc-ar"
export RANLIB="${gcc_prefix}/bin/${tuple}-gcc-ranlib"
export CFLAGS="-O2 -fPIC"
export CXXFLAGS="-O2 -fPIC"
jobs="$(nproc)"

# Download a source archive and unpack it into a new build folder, whose path
# the function prints.
function unpack() {
  local url="${1}"
  local name="${url##*/}"
  local dir="/tmp/build-${name%%.tar.*}"
  /fetch "${url}" "/tmp/${name}"
  mkdir -p "${dir}"
  tar -xf "/tmp/${name}" --strip-components=1 -C "${dir}"
  rm "/tmp/${name}"
  printf '%s\n' "${dir}"
}

function cmake_static() {
  local source_dir="${1}"
  shift
  cmake -G Ninja -S "${source_dir}" -B "${source_dir}/build" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="${dest}" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DBUILD_SHARED_LIBS=OFF \
    "$@"
  cmake --build "${source_dir}/build" --parallel "${jobs}"
  cmake --install "${source_dir}/build"
  rm -rf "${source_dir}"
}

dir="$(unpack "https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz")"
pushd "${dir}" >/dev/null
./configure --prefix="${dest}" --libdir="${dest}/lib" --static
make -j"${jobs}"
make install
popd >/dev/null
rm -rf "${dir}"

dir="$(unpack "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz")"
cmake_static "${dir}/build/cmake" \
  -DZSTD_BUILD_SHARED=OFF \
  -DZSTD_BUILD_STATIC=ON \
  -DZSTD_BUILD_PROGRAMS=OFF \
  -DZSTD_BUILD_TESTS=OFF \
  -DZSTD_MULTITHREAD_SUPPORT=ON
rm -rf "${dir}"

dir="$(unpack "https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.4.tar.xz")"
cmake_static "${dir}" \
  -DLIBXML2_WITH_ICONV=OFF \
  -DLIBXML2_WITH_ICU=OFF \
  -DLIBXML2_WITH_LZMA=OFF \
  -DLIBXML2_WITH_PROGRAMS=OFF \
  -DLIBXML2_WITH_PYTHON=OFF \
  -DLIBXML2_WITH_TESTS=OFF \
  -DLIBXML2_WITH_ZLIB=OFF

dir="$(unpack "https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz")"
pushd "${dir}" >/dev/null
./configure --prefix="${dest}" --libdir="${dest}/lib" --host="${tuple}" \
  --disable-docs --disable-multi-os-directory --disable-shared --enable-static --with-pic
make -j"${jobs}"
make install
popd >/dev/null
rm -rf "${dir}"

for lib in libz.a libzstd.a libxml2.a libffi.a; do
  test -f "${dest}/lib/${lib}"
done
