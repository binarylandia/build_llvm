#!/usr/bin/env bash

set -euxo pipefail

export BUILDKIT_PROGRESS=plain
export PROGRESS_NO_TRUNC=1

DOCKER_REPO="llvm_builder"
DOCKER_IMAGE_NAME_SAFE="${DOCKER_REPO//\//-}"
DOCKER_CONTAINER_NAME="${DOCKER_IMAGE_NAME_SAFE}-$(date -u "+%Y-%m-%d_%H-%M-%S_%3NZ")"

# manylinux2014 (glibc 2.17) by digest, so every build starts from the same image.
DOCKER_BASE_IMAGE="quay.io/pypa/manylinux2014_x86_64@sha256:f6a6f153c9cf45470507ebbc27013e5db14ce21331b62fd2c540561f25e5f0a5"

# The commit that the build runs, recorded in the metadata of the archives.
# scripts/release publishes only builds of a clean, pushed commit.
BUILD_COMMIT="$(git rev-parse HEAD)"
BUILD_DIRTY="false"
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  BUILD_DIRTY="true"
fi
# The time of the commit, used as the time of every archive entry.
SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
BUILD_TIME="${BUILD_TIME:-$(date -u "+%Y-%m-%d_%H-%M-%S")}"

USER="user"
GROUP="user"

docker build \
  --tag="${DOCKER_IMAGE_NAME_SAFE}" \
  --build-arg="DOCKER_BASE_IMAGE=${DOCKER_BASE_IMAGE}" \
  --build-arg="UID=$(id -u)" \
  --build-arg="GID=$(id -g)" \
  --build-arg="USER=${USER}" \
  --build-arg="GROUP=${GROUP}" \
  .

mkdir -p .build .cache/ccache .opt .out

tty_flags=()
if tty -s; then
  tty_flags=(--interactive --tty)
fi

docker run --rm "${tty_flags[@]}" \
  --init \
  --name="${DOCKER_CONTAINER_NAME}" \
  --hostname="${DOCKER_IMAGE_NAME_SAFE}" \
  --user="$(id -u):$(id -g)" \
  --cap-drop=ALL \
  --volume="$(pwd):/workdir" \
  --volume="$(pwd)/.opt:/opt/llvm" \
  --volume="$(pwd)/.cache/ccache:/cache/ccache" \
  --workdir="/workdir" \
  --env="UID=$(id -u)" \
  --env="GID=$(id -g)" \
  --env="USER=${USER}" \
  --env="GROUP=${GROUP}" \
  --env="PS1=\${USER}@\${HOST}" \
  --env="TZ=Etc/UTC" \
  --env="LANG=C.UTF-8" \
  --env="DOCKER_BASE_IMAGE=${DOCKER_BASE_IMAGE}" \
  --env="BUILD_COMMIT=${BUILD_COMMIT}" \
  --env="BUILD_DIRTY=${BUILD_DIRTY}" \
  --env="SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}" \
  --env="BUILD_TIME=${BUILD_TIME}" \
  --ulimit core=0 \
  "${DOCKER_IMAGE_NAME_SAFE}" \
  bash -c "${*:-./scripts/main}"
