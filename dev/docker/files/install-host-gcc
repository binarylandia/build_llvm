#!/usr/bin/env bash
#
# Usage: $0 <prefix>
#
# Install the x86_64-unknown-linux-gnu GCC 16 toolchain of binarylandia/
# build_crosstool-ng into a prefix. Its sysroot has glibc 2.17: the first LLVM
# stage is compiled by its GCC, and every later stage compiles and links on its
# sysroot, crt files, and libgcc, so the LLVM tools run on any Linux host with
# glibc 2.17 or later, whatever the glibc of this image.
#
# The prefix gets the download record toolchain.json (see /fetch).
#
set -euo pipefail

dest="${1:?prefix}"
tuple="x86_64-unknown-linux-gnu"
version="16.2.0"
build_time="2026-10-18_08-33-54"
release="gcc-15.3.0_${version}-${build_time}"
archive="/tmp/host-gcc.tar.xz"

mkdir -p "${dest}"
/fetch "https://github.com/binarylandia/build_crosstool-ng/releases/download/${release}/gcc-${version}-${tuple}-${build_time}.tar.xz" \
  "${archive}" "${dest}/toolchain.json"
xz -dc -T0 "${archive}" | tar -C "${dest}" -x
rm "${archive}"

"${dest}/bin/${tuple}-gcc" --version
